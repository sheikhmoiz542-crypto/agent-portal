# Copy this file to .env (local) or set these in your host's dashboard.
SESSION_SECRET=change-me-to-a-long-random-string
APP_NAME=Shift Desk
TZ_NAME=Asia/Karachi
# First-run manager account (optional; a random password is printed in the logs if you leave this out)
ADMIN_USERNAME=manager
ADMIN_PASSWORD=
# Folder for the database file. On a host, point this at a persistent disk, e.g. /data
DATA_DIR=./data
# Needed only when a stats source will push data to /api/stats/ingest
STATS_API_KEY=
