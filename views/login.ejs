<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login - E3 Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white flex items-center justify-center h-screen">
    <div class="bg-slate-800 p-8 rounded-xl shadow-xl w-96 border border-slate-700">
        <h2 class="text-2xl font-bold mb-6 text-center text-indigo-400">E3 Portal Login</h2>
        <% if (error) { %>
            <div class="bg-red-500/20 border border-red-500 text-red-300 p-3 rounded mb-4 text-sm"><%= error %></div>
        <% } %>
        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm text-slate-400 mb-1">Username</label>
                <input type="text" name="username" required class="w-full bg-slate-900 border border-slate-750 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
            </div>
            <div>
                <label class="block text-sm text-slate-400 mb-1">Password</label>
                <div class="relative">
                    <input type="password" name="password" required class="w-full bg-slate-900 border border-slate-750 rounded p-2 pr-10 text-white focus:outline-none focus:border-indigo-500">
                    <button type="button" onclick="togglePw(this)" title="Show/hide password" class="absolute inset-y-0 right-0 px-3 text-slate-500 hover:text-slate-200">
                        <svg class="eye-on w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="eye-off w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="23" x2="23" y2="1"/></svg>
                    </button>
                </div>
            </div>
            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-2 rounded transition">Login</button>
        </form>
        <div class="text-center mt-4">
            <a href="/forgot-password" class="text-xs text-slate-500 hover:text-indigo-400 transition">Forgot password?</a>
        </div>
    </div>

    <script>
        // Show/hide password toggle for the eye icon
        function togglePw(btn) {
            const wrap = btn.closest('.relative');
            const input = wrap ? wrap.querySelector('input') : null;
            if (!input) return;
            const eyeOn = btn.querySelector('.eye-on');
            const eyeOff = btn.querySelector('.eye-off');
            if (input.type === 'password') {
                input.type = 'text';
                if (eyeOn) eyeOn.classList.add('hidden');
                if (eyeOff) eyeOff.classList.remove('hidden');
            } else {
                input.type = 'password';
                if (eyeOn) eyeOn.classList.remove('hidden');
                if (eyeOff) eyeOff.classList.add('hidden');
            }
        }
    </script>
</body>
</html>
