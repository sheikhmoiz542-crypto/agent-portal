<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <script>(function(){try{document.documentElement.setAttribute('data-theme',localStorage.getItem('sd-theme')||'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();</script>
    <link rel="stylesheet" href="/theme.css?v=2">
    <script src="/theme.js?v=2" defer></script>
    <title>My Uploaded Chats - E3 Group</title>
    <style>
        body { background-color: #0d0f18; color: #e2e8f0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 30px; }
        .header { display: flex; justify-content: space-between; align-items: center; background: #151929; padding: 20px 30px; border-radius: 12px; border: 1px solid #262d47; }
        .header h1 { margin: 0; font-size: 20px; color: #fbbf24; }
        a.back { background: #1e2538; color: #e2e8f0; padding: 8px 16px; text-decoration: none; font-weight: bold; border-radius: 6px; font-size: 13px; border: 1px solid #334155; }
        a.back:hover { background: #252d4a; }
        
        .container { background: #151929; margin-top: 25px; padding: 25px; border-radius: 12px; border: 1px solid #262d47; }
        h3 { margin-top: 0; color: #fbbf24; font-size: 14px; border-bottom: 1px solid #262d47; padding-bottom: 10px; }
        ul { list-style: none; padding: 0; margin: 0; }
        li { background: #1e2538; padding: 12px 15px; margin-bottom: 10px; border-radius: 8px; border: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; font-size: 13px; }
        li a { color: #38bdf8; text-decoration: none; word-break: break-all; }
        li a:hover { text-decoration: underline; }
        span.time { font-size: 11px; color: #94a3b8; }
        .theme-btn { display:inline-flex; align-items:center; gap:6px; background:#1a1a1a; color:#e5e5e5; border:1px solid #262626; padding:8px 14px; border-radius:6px; font-size:13px; font-weight:bold; cursor:pointer; font-family:inherit; }
        .theme-btn svg { width:15px; height:15px; }
        html[data-theme="dark"] body { background-color:#000000; }
        html[data-theme="dark"] .header, html[data-theme="dark"] .card, html[data-theme="dark"] .container { background:#0d0d0d; border-color:#262626; }
        html[data-theme="dark"] th { background:#141414; }
        html[data-theme="dark"] td { border-color:#1a1a1a; }
        html[data-theme="dark"] tr:hover { background:#111111; }
        html[data-theme="dark"] input.sched-input { background:#000000; border-color:#262626; }
        html[data-theme="dark"] li { background:#141414; border-color:#262626; }
        html[data-theme="dark"] a.back { background:#141414; border-color:#262626; }
        html[data-theme="light"] body { background-color:#f1f5f9; color:#0f172a; }
        html[data-theme="light"] .header, html[data-theme="light"] .card, html[data-theme="light"] .container { background:#ffffff; border-color:#e2e8f0; box-shadow:0 4px 20px rgba(15,23,42,0.06); }
        html[data-theme="light"] .header h1, html[data-theme="light"] h3 { color:#b45309; }
        html[data-theme="light"] h3 { border-color:#e2e8f0; }
        html[data-theme="light"] .header span { color:#64748b; }
        html[data-theme="light"] th { background:#f1f5f9; color:#b45309; border-color:#e2e8f0; }
        html[data-theme="light"] td { border-color:#e2e8f0; color:#334155; }
        html[data-theme="light"] tr:hover { background:#f8fafc; }
        html[data-theme="light"] input.sched-input { background:#ffffff; border-color:#cbd5e1; color:#0f172a; }
        html[data-theme="light"] .stat-box { color:#047857; }
        html[data-theme="light"] li { background:#f8fafc; border-color:#e2e8f0; }
        html[data-theme="light"] li a { color:#0369a1; }
        html[data-theme="light"] span.time { color:#64748b; }
        html[data-theme="light"] a.back { background:#f1f5f9; border-color:#e2e8f0; color:#0f172a; }
        html[data-theme="light"] .badge-off { background:#e2e8f0; color:#64748b; }
        html[data-theme="light"] .theme-btn { background:#ffffff; color:#0f172a; border-color:#e2e8f0; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Uploaded Chats for <%= fullName %> (Today)</h1>
        <div style="display:flex; gap:10px; align-items:center;">
        <button type="button" data-theme-toggle class="theme-btn"></button>
        <a class="back" href="/agent">← Back to Dashboard</a>
        </div>
    </div>

    <div class="container">
        <h3>YOUR SUBMITTED LINKS TODAY</h3>
        <% if (myLinks.length === 0) { %>
            <p style="color: #94a3b8; font-size: 13px;">You haven't submitted any chat links yet today.</p>
        <% } else { %>
            <ul>
                <% myLinks.forEach((item, index) => { %>
                    <li>
                        <a href="<%= item.link %>" target="_blank"><%= item.link %></a>
                        <span class="time"><%= item.created_at %></span>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </div>
</body>
</html>
