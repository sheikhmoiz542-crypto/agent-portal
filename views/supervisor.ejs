<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Supervisor Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen">
    <nav class="bg-slate-800 border-b border-slate-700 px-4 sm:px-6 py-4 flex flex-wrap justify-between items-center gap-3">
        <div class="flex items-center gap-3">
            <h1 class="text-lg sm:text-xl font-bold text-indigo-400">Supervisor Dashboard</h1>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded border bg-indigo-600/20 text-indigo-300 border-indigo-600/40"><%= userRole %></span>
        </div>
        <div class="flex gap-2 sm:gap-3 flex-wrap">
            <span class="text-xs text-slate-500 self-center">Welcome, <%= viewerName %></span>
            <a href="<%= backUrl %>" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded text-sm font-semibold transition">Back</a>
            <a href="/logout" class="bg-red-600 hover:bg-red-500 px-4 py-2 rounded text-sm font-semibold transition">Logout</a>
        </div>
    </nav>

    <div class="max-w-6xl mx-auto p-4 sm:p-6 space-y-6">
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-green-500/20 border border-green-500 text-green-300 p-3 rounded text-sm"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-500/20 border border-red-500 text-red-300 p-3 rounded text-sm"><%= error %></div>
        <% } %>
        <% const hhmm = (ms) => { const d = new Date(ms); return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }; %>

        <!-- Live now -->
        <div class="bg-slate-800 p-4 sm:p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300">Live Right Now</h2>
            <div class="grid grid-cols-3 gap-3 mb-5">
                <div class="bg-slate-900 rounded-lg p-3 sm:p-4 text-center border border-slate-700">
                    <div class="text-2xl sm:text-3xl font-bold text-slate-100"><%= todayTotals.links %></div>
                    <div class="text-[11px] sm:text-xs text-slate-500 uppercase tracking-wider mt-1">Links today</div>
                </div>
                <div class="bg-slate-900 rounded-lg p-3 sm:p-4 text-center border border-slate-700">
                    <div class="text-2xl sm:text-3xl font-bold text-amber-300"><%= todayTotals.followups %></div>
                    <div class="text-[11px] sm:text-xs text-slate-500 uppercase tracking-wider mt-1">Follow-ups today</div>
                </div>
                <div class="bg-slate-900 rounded-lg p-3 sm:p-4 text-center border border-slate-700">
                    <div class="text-2xl sm:text-3xl font-bold text-indigo-300"><%= todayTotals.total %></div>
                    <div class="text-[11px] sm:text-xs text-slate-500 uppercase tracking-wider mt-1">Total today</div>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <h3 class="text-sm font-semibold text-slate-400 mb-2">On shift now</h3>
                    <div class="flex flex-wrap gap-2">
                        <% const onShift = live.filter(l => l.state === 'in'); %>
                        <% if (onShift.length === 0) { %>
                            <span class="text-xs text-slate-500">Nobody on shift right now.</span>
                        <% } %>
                        <% onShift.forEach(l => { %>
                            <span class="inline-flex items-center gap-2 bg-green-600/15 border border-green-600/40 text-green-300 text-xs font-semibold px-3 py-1.5 rounded-full">
                                <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                                <%= l.full_name %> <span class="text-green-500/80 font-normal"><%= l.shiftLabel %></span>
                            </span>
                        <% }) %>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-slate-400 mb-2">On break now</h3>
                    <div class="flex flex-wrap gap-2">
                        <% if (liveBreaks.length === 0) { %>
                            <span class="text-xs text-slate-500">Nobody on break right now.</span>
                        <% } %>
                        <% liveBreaks.forEach(b => { %>
                            <span class="inline-flex items-center gap-2 bg-amber-600/15 border border-amber-600/40 text-amber-300 text-xs font-semibold px-3 py-1.5 rounded-full">
                                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                                <%= b.full_name %> <span class="text-amber-500/80 font-normal">break #<%= b.break_num %> since <%= hhmm(b.started_at) %></span>
                            </span>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Punctuality -->
        <div class="bg-slate-800 p-4 sm:p-6 rounded-xl border border-slate-700 shadow-lg overflow-x-auto">
            <h2 class="text-lg font-semibold mb-1 text-indigo-300">Today's Punctuality</h2>
            <p class="text-xs text-slate-500 mb-4">Shift start vs first link of the shift (10 min grace). Read-only.</p>
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                        <th class="p-3">Agent</th>
                        <th class="p-3">Shift</th>
                        <th class="p-3">First link</th>
                        <th class="p-3">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% live.forEach(l => { %>
                        <tr class="border-b border-slate-750 hover:bg-slate-750/50">
                            <td class="p-3 font-bold text-indigo-300 whitespace-nowrap"><%= l.full_name %></td>
                            <td class="p-3 text-slate-400 whitespace-nowrap"><%= l.shiftLabel || 'OFF' %></td>
                            <td class="p-3 text-slate-200 whitespace-nowrap"><%= l.firstMs ? hhmm(l.firstMs) : '—' %></td>
                            <td class="p-3 whitespace-nowrap">
                                <% if (l.verdict === 'ontime') { %>
                                    <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-green-600/20 text-green-300 border border-green-600/40">On time</span>
                                <% } else if (l.verdict === 'late') { %>
                                    <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-red-600/20 text-red-300 border border-red-600/40">Late <%= l.lateMin %> min</span>
                                <% } else if (l.verdict === 'waiting') { %>
                                    <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-amber-600/20 text-amber-300 border border-amber-600/40">No links yet</span>
                                <% } else if (l.verdict === 'absent') { %>
                                    <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-red-600/20 text-red-300 border border-red-600/40">Absent (0 links)</span>
                                <% } else if (l.verdict === 'upcoming') { %>
                                    <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-slate-600/20 text-slate-300 border border-slate-600/40">Starts <%= l.shiftLabel ? l.shiftLabel.split(' - ')[0] : '' %></span>
                                <% } else { %>
                                    <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-slate-700/40 text-slate-500 border border-slate-700">OFF</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Team overview -->
        <div class="bg-slate-800 p-4 sm:p-6 rounded-xl border border-slate-700 shadow-lg overflow-x-auto">
            <h2 class="text-lg font-semibold mb-1 text-indigo-300">Team Overview</h2>
            <p class="text-xs text-slate-500 mb-4">How many links each agent is logging — today, this week and this month.</p>
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                        <th class="p-3" rowspan="2">Agent</th>
                        <th class="p-3 text-center border-l border-slate-700" colspan="3">Today</th>
                        <th class="p-3 text-center border-l border-slate-700" colspan="3">This Week</th>
                        <th class="p-3 text-center border-l border-slate-700" colspan="3">This Month</th>
                    </tr>
                    <tr class="bg-slate-900 text-slate-500 border-b border-slate-700 text-xs">
                        <th class="p-2 text-center border-l border-slate-700">Links</th><th class="p-2 text-center">F-ups</th><th class="p-2 text-center">Total</th>
                        <th class="p-2 text-center border-l border-slate-700">Links</th><th class="p-2 text-center">F-ups</th><th class="p-2 text-center">Total</th>
                        <th class="p-2 text-center border-l border-slate-700">Links</th><th class="p-2 text-center">F-ups</th><th class="p-2 text-center">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% snapshot.forEach(s => { %>
                        <tr class="border-b border-slate-750 hover:bg-slate-750/50">
                            <td class="p-3 font-bold text-indigo-300 whitespace-nowrap"><%= s.full_name %></td>
                            <td class="p-3 text-center border-l border-slate-800 text-slate-200"><%= s.d_links %></td>
                            <td class="p-3 text-center text-amber-300"><%= s.d_followups %></td>
                            <td class="p-3 text-center font-bold text-slate-100"><%= s.d_links + s.d_followups %></td>
                            <td class="p-3 text-center border-l border-slate-800 text-slate-200"><%= s.w_links %></td>
                            <td class="p-3 text-center text-amber-300"><%= s.w_followups %></td>
                            <td class="p-3 text-center font-bold text-slate-100"><%= s.w_links + s.w_followups %></td>
                            <td class="p-3 text-center border-l border-slate-800 text-slate-200"><%= s.m_links %></td>
                            <td class="p-3 text-center text-amber-300"><%= s.m_followups %></td>
                            <td class="p-3 text-center font-bold text-slate-100"><%= s.m_links + s.m_followups %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Today's breaks -->
        <div class="bg-slate-800 p-4 sm:p-6 rounded-xl border border-slate-700 shadow-lg overflow-x-auto">
            <h2 class="text-lg font-semibold mb-1 text-indigo-300">Today's Breaks</h2>
            <p class="text-xs text-slate-500 mb-4">How much break time each agent has used today, and any overtime.</p>
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                        <th class="p-3">Agent</th>
                        <th class="p-3 text-center">Breaks taken</th>
                        <th class="p-3 text-center">Minutes used</th>
                        <th class="p-3 text-center">Overtime</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (breakToday.length === 0) { %>
                        <tr><td colspan="4" class="p-3 text-center text-slate-500">No breaks logged today yet.</td></tr>
                    <% } %>
                    <% breakToday.forEach(b => { %>
                        <tr class="border-b border-slate-750 hover:bg-slate-750/50">
                            <td class="p-3 font-bold text-indigo-300 whitespace-nowrap"><%= b.full_name %></td>
                            <td class="p-3 text-center text-slate-200"><%= b.breaks_taken %></td>
                            <td class="p-3 text-center text-slate-200"><%= b.minutes_used %> min</td>
                            <td class="p-3 text-center <%= b.minutes_over > 0 ? 'text-red-400 font-bold' : 'text-slate-500' %>"><%= b.minutes_over > 0 ? b.minutes_over + ' min over' : '—' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Read-only week schedule -->
        <div class="bg-slate-800 p-4 sm:p-6 rounded-xl border border-slate-700 shadow-lg overflow-x-auto">
            <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
                <div>
                    <h2 class="text-lg font-semibold text-indigo-300">Team Schedule</h2>
                    <p class="text-xs text-slate-500">Read-only — supervisors cannot change schedules.</p>
                </div>
                <form method="GET" action="/supervisor" class="flex gap-2 items-center">
                    <select name="week" class="bg-slate-900 border border-slate-700 rounded p-2 text-white text-sm focus:outline-none focus:border-indigo-500">
                        <% weeks.forEach(w => { %>
                            <option value="<%= w.week_start %>" <%= w.week_start === selWeek ? 'selected' : '' %>><%= w.label %></option>
                        <% }) %>
                    </select>
                    <button type="submit" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded text-sm font-semibold transition">View</button>
                </form>
            </div>
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                        <th class="p-3">Agent</th>
                        <th class="p-3 text-center">Mon</th>
                        <th class="p-3 text-center">Tue</th>
                        <th class="p-3 text-center">Wed</th>
                        <th class="p-3 text-center">Thu</th>
                        <th class="p-3 text-center">Fri</th>
                        <th class="p-3 text-center">Sat</th>
                        <th class="p-3 text-center">Sun</th>
                    </tr>
                </thead>
                <tbody>
                    <% weekSchedules.forEach(ws => { %>
                        <tr class="border-b border-slate-750 hover:bg-slate-750/50">
                            <td class="p-3 font-bold text-indigo-300 whitespace-nowrap"><%= ws.full_name %></td>
                            <% ['mon','tue','wed','thu','fri','sat','sun'].forEach(k => { %>
                                <td class="p-3 text-center whitespace-nowrap <%= ws.days[k] === 'OFF' ? 'text-slate-600' : 'text-slate-200' %>"><%= ws.days[k] %></td>
                            <% }) %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Report generator -->
        <div class="bg-slate-800 p-4 sm:p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-1 text-indigo-300">Pull a Report</h2>
            <p class="text-xs text-slate-500 mb-4">Daily, weekly, monthly or a custom date range — for one agent or the whole team, including past dates.</p>
            <form method="GET" action="/supervisor" class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-6 gap-3 items-end">
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Agent</label>
                    <select name="agent" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                        <option value="ALL" <%= rAgent === 'ALL' ? 'selected' : '' %>>Whole Team</option>
                        <% agents.forEach(a => { %>
                            <option value="<%= a.username %>" <%= rAgent === a.username ? 'selected' : '' %>><%= a.full_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Period</label>
                    <select name="period" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                        <option value="daily" <%= rPeriod === 'daily' ? 'selected' : '' %>>Daily</option>
                        <option value="weekly" <%= rPeriod === 'weekly' ? 'selected' : '' %>>Weekly</option>
                        <option value="monthly" <%= rPeriod === 'monthly' ? 'selected' : '' %>>Monthly</option>
                        <option value="custom" <%= rPeriod === 'custom' ? 'selected' : '' %>>Custom range</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Date</label>
                    <input type="date" name="date" value="<%= rDate %>" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">From <span class="text-slate-600">(custom)</span></label>
                    <input type="date" name="from" value="<%= rFrom %>" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">To <span class="text-slate-600">(custom)</span></label>
                    <input type="date" name="to" value="<%= rTo %>" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 px-6 py-2 rounded font-semibold transition">Generate Report</button>
                </div>
            </form>
        </div>

        <% if (wantReport && report) { %>
        <div class="bg-slate-800 p-4 sm:p-6 rounded-xl border border-slate-700 shadow-lg">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-semibold text-indigo-300"><%= report.label %></h2>
                <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded text-sm font-semibold transition">Print / Save as PDF</button>
            </div>
            <%- include('_report-table', {report: report}) %>
        </div>
        <% } %>
    </div>
</body>
</html>
