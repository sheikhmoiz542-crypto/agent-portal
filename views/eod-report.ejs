<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>EOD Report - <%= fullName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>html { color-scheme: dark; }</style>
</head>
<body class="bg-slate-900 text-white min-h-screen">
    <nav class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center">
        <div>
            <h1 class="text-xl font-bold text-indigo-400">EOD Report</h1>
            <p class="text-xs text-slate-500 mt-0.5">Welcome, <%= fullName %></p>
        </div>
        <div class="flex gap-2">
            <a href="/agent/<%= username %>" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded text-sm font-semibold transition">&larr; Back to Agent Portal</a>
            <a href="/logout" class="bg-red-600 hover:bg-red-500 px-4 py-2 rounded text-sm font-semibold transition">Logout</a>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto p-6">
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <h2 class="text-lg font-semibold text-indigo-300">EOD Report <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-indigo-600/25 text-indigo-200">Previous Shift</span></h2>
                <span class="text-xs text-slate-400">Shift date: <%= date %></span>
            </div>
            <% if (team.total > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead>
                        <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                            <th class="p-3">Agent</th>
                            <th class="p-3">Submitted</th>
                            <th class="p-3">Follow-ups</th>
                            <th class="p-3">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% rows.forEach(r => { %>
                        <tr class="border-b border-slate-700/50">
                            <td class="p-3 font-semibold text-slate-100"><%= r.full_name %></td>
                            <td class="p-3 font-bold text-emerald-300"><%= r.links %></td>
                            <td class="p-3 font-bold text-amber-300"><%= r.followups %></td>
                            <td class="p-3 font-bold text-indigo-300"><%= r.total %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot>
                        <tr class="bg-slate-900 font-bold">
                            <td class="p-3">Team Total</td>
                            <td class="p-3 text-emerald-300"><%= team.links %></td>
                            <td class="p-3 text-amber-300"><%= team.followups %></td>
                            <td class="p-3 text-indigo-300"><%= team.total %></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <% } else { %>
            <p class="text-sm text-slate-400">No links were logged in the previous shift.</p>
            <% } %>
            <a href="/agent/<%= username %>" class="inline-block mt-6 bg-indigo-600 hover:bg-indigo-500 px-5 py-2.5 rounded font-semibold text-sm transition">&larr; Back to Agent Portal</a>
        </div>
    </div>
</body>
</html>
