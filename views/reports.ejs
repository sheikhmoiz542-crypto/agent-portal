<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Team Reports</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen">
    <nav class="bg-slate-800 border-b border-slate-700 px-4 sm:px-6 py-4 flex flex-wrap justify-between items-center gap-3">
        <div class="flex items-center gap-3">
            <h1 class="text-lg sm:text-xl font-bold text-indigo-400">Team Reports</h1>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded border <%= isOwner ? 'bg-amber-600/20 text-amber-300 border-amber-600/40' : 'bg-indigo-600/20 text-indigo-300 border-indigo-600/40' %>"><%= isOwner ? 'Owner' : 'Manager' %></span>
        </div>
        <div class="flex gap-2 sm:gap-3 flex-wrap">
            <a href="/manager" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded text-sm font-semibold transition">Back to Dashboard</a>
            <a href="/logout" class="bg-red-600 hover:bg-red-500 px-4 py-2 rounded text-sm font-semibold transition">Logout</a>
        </div>
    </nav>

    <div class="max-w-6xl mx-auto p-4 sm:p-6 space-y-6">
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-green-500/20 border border-green-500 text-green-300 p-3 rounded text-sm"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-500/20 border border-red-500 text-red-300 p-3 rounded text-sm"><%= error %></div>
        <% } %>

        <div class="bg-slate-800 p-4 sm:p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-1 text-indigo-300">Pull a Report</h2>
            <p class="text-xs text-slate-500 mb-4">Daily, weekly or monthly — for one agent or the whole team, including past dates.</p>
            <form method="GET" action="/manager/reports" class="grid grid-cols-1 sm:grid-cols-4 gap-3 items-end">
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Agent</label>
                    <select name="agent" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                        <option value="ALL" <%= rAgent === 'ALL' ? 'selected' : '' %>>Whole Team</option>
                        <% agents.forEach(a => { %>
                            <option value="<%= a.username %>" <%= rAgent === a.username ? 'selected' : '' %>><%= a.full_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Period</label>
                    <select name="period" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                        <option value="daily" <%= rPeriod === 'daily' ? 'selected' : '' %>>Daily</option>
                        <option value="weekly" <%= rPeriod === 'weekly' ? 'selected' : '' %>>Weekly</option>
                        <option value="monthly" <%= rPeriod === 'monthly' ? 'selected' : '' %>>Monthly</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Date</label>
                    <input type="date" name="date" value="<%= rDate %>" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 px-6 py-2 rounded font-semibold transition">Generate Report</button>
                </div>
            </form>
        </div>

        <% if (wantReport && report) { %>
        <div class="bg-slate-800 p-4 sm:p-6 rounded-xl border border-slate-700 shadow-lg">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-semibold text-indigo-300"><%= report.label %></h2>
                <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded text-sm font-semibold transition">Print / Save as PDF</button>
            </div>
            <%- include('_report-table', {report: report}) %>
        </div>
        <% } %>
    </div>
</body>
</html>
