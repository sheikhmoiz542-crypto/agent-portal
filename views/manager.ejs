<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manager Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen">
    <nav class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center">
        <h1 class="text-xl font-bold text-indigo-400">Manager Portal - Dashboard</h1>
        <div class="flex gap-3">
            <a href="/manager/preview-schedule" target="_blank" class="bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded text-sm font-semibold transition">Preview Team Schedule</a>
            <a href="/logout" class="bg-red-600 hover:bg-red-500 px-4 py-2 rounded text-sm font-semibold transition">Logout</a>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto p-6 space-y-6">
        <% if (success) { %>
            <div class="bg-green-500/20 border border-green-500 text-green-300 p-3 rounded text-sm"><%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="bg-red-500/20 border border-red-500 text-red-300 p-3 rounded text-sm"><%= error %></div>
        <% } %>

        <!-- Set Schedule Date Range Section -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300">Set Active Schedule Date Range (For Slack/WhatsApp Previews)</h2>
            <form action="/update-schedule-range" method="POST" class="flex gap-3">
                <input type="text" name="schedule_range" value="<%= scheduleRange %>" placeholder="e.g. Mon 28 Sep 2026 - Sun 04 Oct 2026" required class="flex-1 bg-slate-900 border border-slate-750 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 px-6 py-2 rounded font-semibold transition">Update Range</button>
            </form>
        </div>

        <!-- Filter & Stats Section -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300">Filter Agent Stats by Date & Agent</h2>
            <form action="/manager" method="GET" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Select Date</label>
                    <input type="date" name="date" value="<%= selectedDate %>" class="w-full bg-slate-900 border border-slate-750 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Select Agent</label>
                    <select name="agent" class="w-full bg-slate-900 border border-slate-750 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                        <option value="">All Agents</option>
                        <% agents.forEach(agent => { %>
                            <option value="<%= agent.username %>" <%= selectedAgent === agent.username ? 'selected' : '' %>><%= agent.full_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-500 py-2 rounded font-semibold transition">Filter</button>
                    <a href="/manager" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded text-center font-semibold transition">Reset</a>
                </div>
            </form>
        </div>

        <!-- Add New Agent Section -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300">Add New Agent</h2>
            <form action="/add-agent" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Agent Name</label>
                    <input type="text" name="name" required placeholder="e.g. Ali Khan" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Email Address</label>
                    <input type="email" name="email" required placeholder="e.g. ali@company.com" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Password</label>
                    <div class="relative">
                        <input type="password" name="password" required minlength="4" placeholder="Min. 4 characters" class="w-full bg-slate-900 border border-slate-700 rounded p-2 pr-10 text-white focus:outline-none focus:border-indigo-500">
                        <button type="button" onclick="togglePw(this)" title="Show/hide password" class="absolute inset-y-0 right-0 px-3 text-slate-500 hover:text-slate-200">
                            <svg class="eye-on w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="eye-off w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="23" x2="23" y2="1"/></svg>
                        </button>
                    </div>
                </div>
                <div>
                    <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-400 px-6 py-2 rounded font-semibold text-white transition">Add Agent</button>
                </div>
            </form>
            <p class="text-xs text-slate-500 mt-3">The agent's login username is auto-generated from the email address (e.g. ali.khan@company.com → alikhan). New agents start with all days OFF — set their weekly schedule below.</p>
        </div>

        <!-- Change Password (Manager) -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300">Change Your Password</h2>
            <form action="/change-password" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Current Password</label>
                    <div class="relative">
                        <input type="password" name="current_password" required class="w-full bg-slate-900 border border-slate-700 rounded p-2 pr-10 text-white focus:outline-none focus:border-indigo-500">
                        <button type="button" onclick="togglePw(this)" title="Show/hide password" class="absolute inset-y-0 right-0 px-3 text-slate-500 hover:text-slate-200">
                            <svg class="eye-on w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="eye-off w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="23" x2="23" y2="1"/></svg>
                        </button>
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">New Password</label>
                    <div class="relative">
                        <input type="password" name="new_password" required minlength="4" class="w-full bg-slate-900 border border-slate-700 rounded p-2 pr-10 text-white focus:outline-none focus:border-indigo-500">
                        <button type="button" onclick="togglePw(this)" title="Show/hide password" class="absolute inset-y-0 right-0 px-3 text-slate-500 hover:text-slate-200">
                            <svg class="eye-on w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="eye-off w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="23" x2="23" y2="1"/></svg>
                        </button>
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Confirm New Password</label>
                    <div class="relative">
                        <input type="password" name="confirm_password" required minlength="4" class="w-full bg-slate-900 border border-slate-700 rounded p-2 pr-10 text-white focus:outline-none focus:border-indigo-500">
                        <button type="button" onclick="togglePw(this)" title="Show/hide password" class="absolute inset-y-0 right-0 px-3 text-slate-500 hover:text-slate-200">
                            <svg class="eye-on w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="eye-off w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="23" x2="23" y2="1"/></svg>
                        </button>
                    </div>
                </div>
                <div>
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 px-6 py-2 rounded font-semibold transition">Change Password</button>
                </div>
            </form>
        </div>

        <!-- Weekly Schedule Management Section -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300">Manage Weekly Schedule for Agents</h2>
            <div class="space-y-4 max-h-96 overflow-y-auto">
                <% agents.forEach(agent => { %>
                    <div class="bg-slate-900 p-4 rounded-lg border border-slate-750 space-y-3">
                    <form action="/update-agent-schedule" method="POST" class="space-y-3">
                        <input type="hidden" name="username" value="<%= agent.username %>">
                        <div class="flex justify-between items-center">
                            <div>
                                <div class="font-bold text-indigo-400"><%= agent.full_name %> (<%= agent.username %>)</div>
                                <% if (agent.email) { %><div class="text-xs text-slate-500"><%= agent.email %></div><% } %>
                            </div>
                            <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 px-4 py-1.5 rounded text-xs font-semibold transition">Save Schedule</button>
                        </div>
                        <div class="grid grid-cols-2 md:grid-cols-7 gap-2 text-xs">
                            <div>
                                <label class="block text-slate-400 mb-1">Mon</label>
                                <input type="text" name="mon" value="<%= agent.mon %>" class="w-full bg-slate-800 border border-slate-700 rounded p-1 text-center text-white">
                            </div>
                            <div>
                                <label class="block text-slate-400 mb-1">Tue</label>
                                <input type="text" name="tue" value="<%= agent.tue %>" class="w-full bg-slate-800 border border-slate-700 rounded p-1 text-center text-white">
                            </div>
                            <div>
                                <label class="block text-slate-400 mb-1">Wed</label>
                                <input type="text" name="wed" value="<%= agent.wed %>" class="w-full bg-slate-800 border border-slate-700 rounded p-1 text-center text-white">
                            </div>
                            <div>
                                <label class="block text-slate-400 mb-1">Thu</label>
                                <input type="text" name="thu" value="<%= agent.thu %>" class="w-full bg-slate-800 border border-slate-700 rounded p-1 text-center text-white">
                            </div>
                            <div>
                                <label class="block text-slate-400 mb-1">Fri</label>
                                <input type="text" name="fri" value="<%= agent.fri %>" class="w-full bg-slate-800 border border-slate-700 rounded p-1 text-center text-white">
                            </div>
                            <div>
                                <label class="block text-slate-400 mb-1">Sat</label>
                                <input type="text" name="sat" value="<%= agent.sat %>" class="w-full bg-slate-800 border border-slate-700 rounded p-1 text-center text-white">
                            </div>
                            <div>
                                <label class="block text-slate-400 mb-1">Sun</label>
                                <input type="text" name="sun" value="<%= agent.sun %>" class="w-full bg-slate-800 border border-slate-700 rounded p-1 text-center text-white">
                            </div>
                        </div>
                    </form>
                    <div class="flex flex-wrap gap-2 items-end pt-3 border-t border-slate-800">
                        <form action="/reset-agent-password" method="POST" class="flex gap-2 items-end" onsubmit="return confirm('Reset password for <%= agent.full_name %>? The agent will need the new password to log in.');">
                            <input type="hidden" name="username" value="<%= agent.username %>">
                            <div class="relative">
                                <input type="password" name="new_password" required minlength="4" placeholder="New password" class="bg-slate-800 border border-slate-700 rounded pl-2 pr-8 py-1.5 text-xs text-white focus:outline-none focus:border-amber-500">
                                <button type="button" onclick="togglePw(this)" title="Show/hide password" class="absolute inset-y-0 right-0 px-2 text-slate-500 hover:text-slate-200">
                                    <svg class="eye-on w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    <svg class="eye-off w-3.5 h-3.5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="23" x2="23" y2="1"/></svg>
                                </button>
                            </div>
                            <button type="submit" class="bg-amber-600 hover:bg-amber-500 px-3 py-1.5 rounded text-xs font-semibold transition">Reset Password</button>
                        </form>
                        <form action="/delete-agent" method="POST" onsubmit="return confirm('Delete agent <%= agent.full_name %> (<%= agent.username %>)? Their login will stop working immediately. This cannot be undone.');">
                            <input type="hidden" name="username" value="<%= agent.username %>">
                            <button type="submit" class="bg-red-600 hover:bg-red-500 px-3 py-1.5 rounded text-xs font-semibold transition">Delete Agent</button>
                        </form>
                    </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- Filtered Links Table -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300">Submitted Links Result</h2>
            <div class="overflow-x-auto max-h-60 overflow-y-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                            <th class="p-3">Agent Name</th>
                            <th class="p-3">Link</th>
                            <th class="p-3">Date (Shift)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (links.length === 0) { %>
                            <tr><td colspan="3" class="p-4 text-center text-slate-500">No records found for selected filter.</td></tr>
                        <% } else { %>
                            <% links.forEach(item => { %>
                                <tr class="border-b border-slate-750 hover:bg-slate-750/50">
                                    <td class="p-3 font-medium"><%= item.full_name %></td>
                                    <td class="p-3"><a href="<%= item.link %>" target="_blank" class="text-indigo-400 hover:underline"><%= item.link %></a></td>
                                    <td class="p-3 text-indigo-400 font-bold"><%= stat.total_links %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Daily Summary Stats by Agent -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300">All Days & Agents Summary Stats</h2>
            <div class="overflow-x-auto max-h-60 overflow-y-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                            <th class="p-3">Date</th>
                            <th class="p-3">Agent Name</th>
                            <th class="p-3">Total Links</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (dailyStats.length === 0) { %>
                            <tr><td colspan="3" class="p-4 text-center text-slate-500">No stats available.</td></tr>
                        <% } else { %>
                            <% dailyStats.forEach(stat => { %>
                                <tr class="border-b border-slate-750 hover:bg-slate-750/50">
                                    <td class="p-3 text-slate-300"><%= stat.date %></td>
                                    <td class="p-3 font-medium"><%= stat.full_name %></td>
                                    <td class="p-3 text-indigo-400 font-bold"><%= stat.total_links %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Show/hide password toggle for the eye icons
        function togglePw(btn) {
            const wrap = btn.closest('.relative');
            const input = wrap ? wrap.querySelector('input') : null;
            if (!input) return;
            const eyeOn = btn.querySelector('.eye-on');
            const eyeOff = btn.querySelector('.eye-off');
            if (input.type === 'password') {
                input.type = 'text';
                if (eyeOn) eyeOn.classList.add('hidden');
                if (eyeOff) eyeOff.classList.remove('hidden');
            } else {
                input.type = 'password';
                if (eyeOn) eyeOn.classList.remove('hidden');
                if (eyeOff) eyeOff.classList.add('hidden');
            }
        }
    </script>
</body>
</html>
