<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Team Weekly Schedule Preview</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen p-8">
<%
    // Week navigation helpers: previous / next week from the selected Monday, plus per-day dates.
    const _p = selectedWeek.split('-').map(Number);
    const _fmt = (dt) => dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0') + '-' + String(dt.getDate()).padStart(2, '0');
    const _base = new Date(_p[0], _p[1] - 1, _p[2]);
    const _prevD = new Date(_base); _prevD.setDate(_base.getDate() - 7);
    const _nextD = new Date(_base); _nextD.setDate(_base.getDate() + 7);
    const prevWeek = _fmt(_prevD), nextWeek = _fmt(_nextD);
    const _now = new Date(); const _diff = (_now.getDay() + 6) % 7; const _mon = new Date(_now); _mon.setDate(_now.getDate() - _diff);
    const currentWeekStr = _fmt(_mon);
    const _months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const _dayNames = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
    const dayHeads = _dayNames.map((n, i) => { const d = new Date(_base); d.setDate(_base.getDate() + i); return { name: n, label: d.getDate() + ' ' + _months[d.getMonth()] }; });
%>
    <div class="max-w-6xl mx-auto space-y-6">
        <div class="flex justify-between items-center bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <div>
                <h1 class="text-2xl font-bold text-indigo-400">Team Weekly Schedule</h1>
                <p class="text-sm text-indigo-300 font-semibold mt-1">Effective Range: <%= scheduleRange %></p>
            </div>
            <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded text-sm font-semibold transition">Print / Save as PDF</button>
        </div>

        <div class="flex flex-wrap items-center gap-2 bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-lg">
            <a href="/manager/preview-schedule?week=<%= prevWeek %>" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700 hover:bg-slate-600 text-slate-200 transition">&lsaquo; Prev Week</a>
            <span class="text-sm font-bold text-indigo-200 px-1"><%= scheduleRange %><% if (selectedWeek === currentWeekStr) { %> <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-indigo-600/30 text-indigo-200 align-middle">This Week</span><% } %></span>
            <a href="/manager/preview-schedule?week=<%= nextWeek %>" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700 hover:bg-slate-600 text-slate-200 transition">Next Week &rsaquo;</a>
            <a href="/manager/preview-schedule" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition">Go to This Week</a>
            <span class="flex-1"></span>
            <a href="/manager#schedules" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700 hover:bg-slate-600 text-slate-200 transition">Back to Manager</a>
        </div>

        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                        <th class="p-3">Agent Name</th>
                        <% dayHeads.forEach(h => { %>
                        <th class="p-3 text-center"><div><%= h.name %></div><div class="text-slate-200 text-xs font-bold"><%= h.label %></div></th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody>
                    <% const days = ['mon','tue','wed','thu','fri','sat','sun']; %>
                    <% agents.forEach(agent => { %>
                        <tr class="border-b border-slate-750 hover:bg-slate-750/50">
                            <td class="p-3 font-bold text-indigo-300 whitespace-nowrap"><%= agent.full_name %></td>
                            <% days.forEach(d => { %>
                                <td class="p-3 text-center <%= agent[d] === 'OFF' ? 'text-slate-600' : 'text-slate-200 font-medium' %>"><%= agent[d] %></td>
                            <% }) %>
                        </tr>
                    <% }) %>
                </tbody>
                <tfoot>
                    <tr class="bg-indigo-950/60 border-t-2 border-indigo-500">
                        <td class="p-3 font-bold text-indigo-300 whitespace-nowrap">Agents on Shift</td>
                        <% days.forEach(d => { %>
                            <% const onShift = agents.filter(a => a[d] && a[d] !== 'OFF').length; %>
                            <td class="p-3 text-center font-bold <%= onShift > 0 ? 'text-indigo-200' : 'text-slate-600' %>"><%= onShift %></td>
                        <% }) %>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</body>
</html>
