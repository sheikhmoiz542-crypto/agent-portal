<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Team Weekly Schedule Preview</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen p-8">
    <div class="max-w-6xl mx-auto space-y-6">
        <div class="flex justify-between items-center bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <div>
                <h1 class="text-2xl font-bold text-indigo-400">Team Weekly Schedule</h1>
                <p class="text-sm text-indigo-300 font-semibold mt-1">Effective Range: <%= scheduleRange %></p>
            </div>
            <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded text-sm font-semibold transition">Print / Save as PDF</button>
        </div>

        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                        <th class="p-3">Agent Name</th>
                        <th class="p-3 text-center">Mon</th>
                        <th class="p-3 text-center">Tue</th>
                        <th class="p-3 text-center">Wed</th>
                        <th class="p-3 text-center">Thu</th>
                        <th class="p-3 text-center">Fri</th>
                        <th class="p-3 text-center">Sat</th>
                        <th class="p-3 text-center">Sun</th>
                    </tr>
                </thead>
                <tbody>
                    <% const days = ['mon','tue','wed','thu','fri','sat','sun']; %>
                    <% agents.forEach(agent => { %>
                        <tr class="border-b border-slate-750 hover:bg-slate-750/50">
                            <td class="p-3 font-bold text-indigo-300 whitespace-nowrap"><%= agent.full_name %></td>
                            <% days.forEach(d => { %>
                                <td class="p-3 text-center <%= agent[d] === 'OFF' ? 'text-slate-600' : 'text-slate-200 font-medium' %>"><%= agent[d] %></td>
                            <% }) %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
